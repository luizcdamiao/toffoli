---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ServicoBloco from '../components/ServicoBloco.astro';
import ContatoForm from '../components/ContatoForm.astro';
import Rodape from '../components/Rodape.astro';
import WhatsApp from '../components/WhatsApp.astro';
import escudo from '../assets/escudo.png';
import { foto } from '../data/fotos';
import {
  empresa, estruturas, caldeiraria, outrasSolucoes, segmentos, regioesPrincipais, regioesOcasionais,
  processo, diferenciais, treinamentos, faq, produtos, projetos, whatsappUrl, google,
} from '../data/site';

const titulo = 'Estruturas Metálicas e Caldeiraria em Andradas, MG';
const descricao =
  'Estruturas metálicas e caldeiraria em Andradas, MG: barracões, coberturas, silos e tanques. Há mais de 30 anos no setor. Peça seu orçamento pelo WhatsApp.';

const fotoHero = foto('hero');
const fotoEmpresa = foto('empresa');
// Mesmo srcset da <Image> do hero, para o navegador começar a baixar a foto já no <head>.
const heroPreload = fotoHero ? await getImage({ src: fotoHero, widths: [640, 1024, 1600], sizes: '100vw' }) : undefined;
const lista = (itens: string[]) => {
  const ini = itens.slice(0, -1).join(', ');
  return `${ini} e ${itens[itens.length - 1]}`;
};
---

<Base titulo={titulo} descricao={descricao}>
  {
    heroPreload && (
      <link slot="head" rel="preload" as="image" href={heroPreload.src} imagesrcset={heroPreload.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
    )
  }
  <Header />
  <main id="conteudo">
    <!-- HERO -->
    <section class={`hero ${fotoHero ? 'hero--foto' : ''}`} id="topo" aria-labelledby="h1">
      {
        fotoHero ? (
          <div class="hero__foto">
            <Image src={fotoHero} alt="Estrutura metálica executada pela Toffoli & Antônio" widths={[640, 1024, 1600]} sizes="100vw" quality={55} loading="eager" fetchpriority="high" />
          </div>
        ) : (
          <div class="hero__arte"><Image src={escudo} alt="" width={460} loading="eager" /></div>
        )
      }
      <div class="wrap hero__grade">
        <div>
          <h1 id="h1">Estruturas Metálicas e Caldeiraria em Andradas, MG</h1>
          <p class="hero__apoio">
            Soluções para indústrias, agronegócio e projetos residenciais, com experiência e compromisso em cada trabalho.
          </p>
          <div class="hero__cta">
            <a class="btn btn--claro" href="#contato">Solicitar orçamento</a>
            <a class="hero__link" href="#servicos">Conheça nossas soluções <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero__local">{empresa.experiencia}</p>
        </div>
      </div>
    </section>

    <!-- ATALHOS PARA AS ÁREAS DE ATUAÇÃO -->
    <nav class="areas" aria-label="Áreas de atuação">
      <ul class="wrap areas__lista">
        <li><a href="#estruturas-metalicas"><span><strong>Estruturas Metálicas</strong><em>Barracões, telhados e coberturas</em></span><b aria-hidden="true">→</b></a></li>
        <li><a href="#caldeiraria"><span><strong>Caldeiraria</strong><em>Plataformas, silos, tanques e dutos</em></span><b aria-hidden="true">→</b></a></li>
        <li><a href="#outras-solucoes"><span><strong>Outras soluções</strong><em>Telhados, pergolados, portões e grades</em></span><b aria-hidden="true">→</b></a></li>
      </ul>
    </nav>

    <!-- EMPRESA -->
    <section id="empresa" class="secao clara" aria-labelledby="empresa-t">
      <div class="wrap empresa__grade">
        <div class="rev">
          <p class="eyebrow">A empresa</p>
          <h2 id="empresa-t">Estruturas metálicas e caldeiraria na região de Andradas</h2>
          <p class="lead" style="margin-top:20px">
            A Toffoli &amp; Antônio trabalha com estruturas metálicas e caldeiraria em Andradas, no Sul de Minas, e atende
            indústrias, propriedades rurais e clientes residenciais da região.
          </p>
          <p class="texto" style="margin-top:16px">
            Do barracão à plataforma de manutenção, cada serviço parte de uma conversa: a equipe entende a necessidade, faz a
            visita técnica quando o serviço pede e apresenta o orçamento em PDF antes de começar.
          </p>
          <p class="texto">
            Compromisso com o trabalho, velocidade no atendimento e suporte depois da entrega são o que a empresa quer manter em
            cada projeto.
          </p>
        </div>
        <div class={`painel rev empresa__foto ${fotoEmpresa ? '' : 'painel--marca'}`}>
          {
            fotoEmpresa ? (
              <Image src={fotoEmpresa} alt="Equipe e instalações da Toffoli & Antônio" widths={[480, 720, 960]} sizes="(min-width: 980px) 520px, 92vw" loading="lazy" />
            ) : (
              <Image src={escudo} alt="" width={240} loading="lazy" />
            )
          }
          <p class="selo">Mais de 30 anos<br /><strong>de experiência</strong></p>
        </div>
      </div>
    </section>

    <!-- SERVIÇOS PRINCIPAIS -->
    <div id="servicos">
      <ServicoBloco
        id="estruturas-metalicas" titulo="Estruturas metálicas para barracões e coberturas" tom="cinza"
        intro="Estruturas para cobrir, proteger e dar uso ao espaço de trabalho. Os barracões atendem a produção industrial e a rotina do campo; as coberturas podem usar telha galvanizada simples ou termoacústica, com forro e fechamento lateral quando o projeto pede."
        detalhes={[
          'Um barracão metálico é montado com pilares, vigas e tesouras de aço que sustentam a cobertura e deixam o espaço interno livre, o que facilita a circulação de máquinas, veículos e estoque.',
          'A telha galvanizada simples é a opção mais direta para cobrir. A termoacústica leva uma camada isolante entre as chapas e costuma ser escolhida quando calor e ruído pesam no ambiente. Forro e fechamento lateral completam o acabamento, e a equipe orienta a escolha conforme o uso do espaço e o orçamento.',
        ]}
        grupos={estruturas} chaveFoto="estruturas-metalicas" altFoto="Estrutura metálica com cobertura executada pela Toffoli & Antônio"
      />
      <ServicoBloco
        id="caldeiraria" titulo="Caldeiraria industrial" tom="escura" inverso
        intro="Peças e estruturas metálicas para a rotina da indústria: plataformas e escadas para acessar equipamentos durante a manutenção, apoios para máquinas, coifas, dutos, silos, tanques, caldeiras e chaminés, além de adaptações e manutenções industriais."
        detalhes={[
          'Caldeiraria é o trabalho de cortar, dobrar, soldar e montar chapas e perfis de aço para fabricar peças sob medida. Na indústria, isso aparece em tanques, silos, dutos, coifas e chaminés, que armazenam, conduzem ou captam materiais e ar.',
          'Plataformas, escadas e corrimãos dão acesso a equipamentos na hora da manutenção; estruturas para máquinas e bancadas apoiam a operação; adaptações e manutenções ajustam o que já existe na planta. A equipe possui treinamentos em NR 06, NR 12, NR 34 e NR 35, que muitas empresas exigem de prestadores de serviço.',
        ]}
        grupos={caldeiraria} chaveFoto="caldeiraria" altFoto="Serviço de caldeiraria executado pela Toffoli & Antônio"
      />
    </div>

    <!-- OUTRAS SOLUÇÕES -->
    <section id="outras-solucoes" class="secao clara" aria-labelledby="outras-t">
      <div class="wrap outras__grade">
        <div class="rev">
          <p class="eyebrow">Também realizamos</p>
          <h2 id="outras-t">Outras soluções para casas e propriedades</h2>
          <p class="texto" style="margin-top:16px">
            Além das duas especialidades, a equipe realiza serviços para casas e propriedades, como telhados, pergolados, portões
            e grades, e serviços de usinagem em torno e fresa.
          </p>
        </div>
        <ul class="chips rev">{outrasSolucoes.map((s) => <li>{s}</li>)}</ul>
      </div>
    </section>

    <!-- SEGMENTOS E REGIÕES -->
    <section id="segmentos" class="secao cinza" aria-labelledby="seg-t">
      <div class="wrap">
        <p class="eyebrow">Quem atendemos</p>
        <h2 id="seg-t">Atendemos Minas Gerais e o interior de São Paulo</h2>
        <div class="segmentos">
          {segmentos.map((s) => <article class="rev"><h3>{s.titulo}</h3><p>{s.texto}</p></article>)}
        </div>
        <div class="regioes rev">
          <h3>Onde atuamos</h3>
          <p>
            Atendemos principalmente {lista(regioesPrincipais)}. Com menor frequência, também atuamos em {lista(regioesOcasionais)}.
          </p>
        </div>
      </div>
    </section>

    <!-- COMO TRABALHAMOS -->
    <section id="como-trabalhamos" class="secao clara" aria-labelledby="proc-t">
      <div class="wrap">
        <p class="eyebrow">Atendimento</p>
        <h2 id="proc-t">Como pedir orçamento de estrutura metálica ou caldeiraria</h2>
        <ol class="passos">
          {processo.map((p) => <li class="rev"><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
        </ol>
      </div>
    </section>

    <!-- DIFERENCIAIS E EQUIPE -->
    <section id="diferenciais" class="secao escura" aria-labelledby="dif-t">
      <div class="wrap">
        <p class="eyebrow">Diferenciais</p>
        <h2 id="dif-t">Por que contratar a Toffoli &amp; Antônio</h2>
        <p class="lead" style="margin-top:18px">
          Cinco pontos que a empresa coloca em primeiro lugar em cada serviço, do primeiro contato ao atendimento depois da entrega.
        </p>
        <ul class="dif">
          {diferenciais.map((d) => <li class="rev"><h3>{d.titulo}</h3><p>{d.texto}</p></li>)}
        </ul>
        <p class="treino">{treinamentos}</p>
      </div>
    </section>

    {
      produtos.length > 0 && (
        <section id="produtos" class="secao clara" aria-labelledby="prod-t">
          <div class="wrap">
            <p class="eyebrow">Catálogo</p>
            <h2 id="prod-t">Produtos</h2>
            <div class="galeria">
              {produtos.map((p) => (
                <figure><img src={p.imagem} alt={p.nome} loading="lazy" /><figcaption><strong>{p.nome}</strong>{p.descricao}</figcaption></figure>
              ))}
            </div>
          </div>
        </section>
      )
    }
    {
      projetos.length > 0 && (
        <section id="projetos" class="secao cinza" aria-labelledby="proj-t">
          <div class="wrap">
            <p class="eyebrow">Obras</p>
            <h2 id="proj-t">Projetos realizados</h2>
            <div class="galeria">
              {projetos.map((p) => (
                <figure><img src={p.imagem} alt={p.titulo} loading="lazy" /><figcaption><strong>{p.titulo}</strong>{p.descricao}</figcaption></figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- FAQ -->
    <section id="faq" class="secao clara" aria-labelledby="faq-t">
      <div class="wrap">
        <p class="eyebrow">Dúvidas</p>
        <h2 id="faq-t">Perguntas frequentes sobre estruturas metálicas e caldeiraria</h2>
        <div class="faq">
          {faq.map((f) => <details><summary>{f.p}</summary><p>{f.r}</p></details>)}
        </div>
      </div>
    </section>

    <!-- CONTATO -->
    <section id="contato" class="secao cinza" aria-labelledby="contato-t">
      <div class="wrap contato__grade">
        <div>
          <p class="eyebrow">Contato</p>
          <h2 id="contato-t">Peça seu orçamento</h2>
          <p class="lead" style="margin-top:18px">
            Descreva o serviço de que você precisa. A equipe avalia a necessidade e, conforme o caso, faz uma visita técnica ou
            envia o orçamento em PDF. O formulário também recebe candidaturas e propostas de parceria.
          </p>
          <a class="btn btn--wa" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chamar no WhatsApp</a>
          <dl class="dados">
            <div><dt>WhatsApp e telefone</dt><dd><a href={`https://wa.me/${empresa.whatsapp}`} rel="noopener">{empresa.telefone}</a></dd></div>
            <div><dt>E-mail</dt><dd><a href={`mailto:${empresa.email}`}>{empresa.email}</a></dd></div>
            <div>
              <dt>Endereço</dt>
              <dd>{empresa.endereco.rua}<br />{empresa.endereco.cidade}, {empresa.endereco.uf} · CEP {empresa.endereco.cep}</dd>
            </div>
          </dl>
        </div>
        <div>
          <ContatoForm />
        </div>
        <div class="local">
          <p class="local__nota">
            <strong>{google.nota} no Google</strong> · {google.avaliacoes} avaliações de clientes<br />
            <a href={google.perfilUrl} target="_blank" rel="noopener noreferrer">Ver avaliações no Google Maps</a>
          </p>
          <iframe
            class="local__mapa"
            title="Localização da Toffoli & Antônio no mapa"
            src={google.mapaEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <a class="local__rota" href={google.perfilUrl} target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a>
        </div>
      </div>
    </section>
  </main>
  <Rodape />
  <WhatsApp />
  <a class="topo-btn" href="#topo" aria-label="Voltar ao topo" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V6M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>

  <script>
    const topoBtn = document.querySelector<HTMLElement>('.topo-btn');
    if (topoBtn) {
      const atualizar = () => { topoBtn.hidden = window.scrollY < window.innerHeight * 0.8; };
      window.addEventListener('scroll', atualizar, { passive: true });
      atualizar();
    }
  </script>

  <script>
    const alvos = document.querySelectorAll('.rev');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vis'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      alvos.forEach((a) => io.observe(a));
    } else {
      alvos.forEach((a) => a.classList.add('vis'));
    }
  </script>
</Base>
