---
import { Image } from 'astro:assets';
import escudo from '../assets/escudo.png';
import { foto } from '../data/fotos';

import type { Grupo } from '../data/site';

interface Props {
  id: string;
  titulo: string;
  intro: string;
  grupos: Grupo[];
  /** Blocos de explicação curtos, em bullets, abaixo dos cartões de grupos. */
  destaques?: Grupo[];
  nota?: string;
  tom: 'clara' | 'escura' | 'cinza';
  inverso?: boolean;
  chaveFoto: string;
  altFoto: string;
}
const { id, titulo, intro, grupos, destaques = [], nota, tom, inverso = false, chaveFoto, altFoto } = Astro.props;
const imagem = foto(chaveFoto);
---

<section id={id} class={`secao ${tom} servico ${inverso ? 'servico--inverso' : ''}`} aria-labelledby={`${id}-t`}>
  <div class="wrap">
    <div class="servico__grade">
      <div class="rev">
        <p class="eyebrow">Serviço principal</p>
        <h2 id={`${id}-t`}>{titulo}</h2>
        <p class="lead" style="margin-top:18px">{intro}</p>
      </div>
      <div class={`painel rev ${imagem ? '' : 'painel--marca'}`}>
        {
          imagem ? (
            <Image src={imagem} alt={altFoto} widths={[480, 720, 960]} sizes="(min-width: 980px) 560px, 92vw" loading="lazy" />
          ) : (
            <Image src={escudo} alt="" width={240} loading="lazy" />
          )
        }
      </div>
    </div>

    <div class="cartoes">
      {
        grupos.map((g) => (
          <article class="cartao rev">
            <h3>{g.titulo}</h3>
            <ul class="checks">{g.itens.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))
      }
    </div>

    {
      destaques.length > 0 && (
        <div class="infos">
          {destaques.map((d) => (
            <article class="info rev">
              <h3>{d.titulo}</h3>
              <ul class="checks">{d.itens.map((i) => <li>{i}</li>)}</ul>
            </article>
          ))}
        </div>
      )
    }

    {nota && <p class="servico__nota rev">{nota}</p>}
  </div>
</section>
