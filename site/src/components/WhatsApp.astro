---
import { whatsappUrl } from '../data/site';
---

<a
  class="whatsapp-float"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-visible="false"
  tabindex="-1"
  aria-hidden="true"
  aria-label="Fale pelo WhatsApp (abre em nova aba)"
>
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
  <span>Fale pelo WhatsApp</span>
</a>

<script>
  const botao = document.querySelector<HTMLAnchorElement>('.whatsapp-float');
  const semBotao = /^\/(admin|auth|contato)(\/|$)/.test(location.pathname);
  if (botao && semBotao) {
    botao.remove();
  } else if (botao) {
    // No celular, o CSS esconde este botão e a seta de voltar ao topo enquanto o formulário está na tela.
    const contato = document.getElementById('form-contato');
    if (contato && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        document.documentElement.dataset.emContato = String(e.isIntersecting);
      }).observe(contato);
    }
    const atualizar = () => {
      const visivel = window.scrollY > 240;
      botao.dataset.visible = String(visivel);
      botao.tabIndex = visivel ? 0 : -1;
      botao.setAttribute('aria-hidden', String(!visivel));
    };
    window.addEventListener('scroll', atualizar, { passive: true });
    atualizar();
  }
</script>
